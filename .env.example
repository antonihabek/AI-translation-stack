# Provider selection. Supported values: openai, claude, deepseek, glm, grok, gemini.
# The CLI flag --provider takes precedence over this variable.
TRANSLATION_PROVIDER=openai

# Optional model override. If empty, the selected provider's default is used.
TRANSLATION_MODEL=
TRANSLATION_EMBEDDING_MODEL=
TRANSLATION_TIMEOUT_MS=120000
TRANSLATION_MAX_COMPLETION_TOKENS=
TRANSLATION_BASE_URL=

# Provider credentials. Set only the key for the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
ZHIPU_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional provider-specific base URL overrides.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
DEEPSEEK_BASE_URL=
GLM_BASE_URL=
XAI_BASE_URL=
GEMINI_BASE_URL=
